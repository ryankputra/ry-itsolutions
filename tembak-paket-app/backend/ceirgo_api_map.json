    {
      "function_name": "verifyWebhookSignature",
      "aliases": ["handleWebhook"],
      "method": "POST (inbound)",
      "path": "/webhooks/order (custom receiver)",
      "permission": "dispatch.webhook.order",
      "docs_url": "https://ceirgo.id/docs/webhooks/order-webhooks",
      "description": "Verifies inbound order result webhook using HMAC-SHA256 with timing-safe equality.",
      "signature_formula": "HMAC_SHA256(JSON.stringify({ orderId, amount }), api_key_secret)",
      "amount_rules": {
        "pending": "String(total_price)",
        "failed_or_cancelled": "\"0\"",
